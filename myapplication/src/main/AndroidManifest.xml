<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  package="com.ghb.cry.app"
  android:sharedUserId="android.uid.system">

  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.READ_PHONE_STATE"/>
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <!-- 系统应用权限 -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <application
    android:name="com.ghb.cry.app.CryApplication"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:supportsRtl="true"
    android:extractNativeLibs="true"
    android:theme="@style/Theme.MyApplication"
    android:persistent="true"
    android:hasCode="true"
    android:networkSecurityConfig="@xml/network_security_config"
    android:largeHeap="true"> <!-- 系统应用常驻内存 -->

    <meta-data
      android:name="com.controller.openMqttService"
      android:value="false" />
    
    <!-- 针对系统应用优化的native库加载配置 -->
    <meta-data
      android:name="android.app.lib_name"
      android:value="snake" />

    <meta-data
      android:name="netpie.auto_start_enabled"
      android:value="false" />
    <!-- 配置插件类型：EIP、KS、AQY，与PluginType枚举名对应 -->
    <meta-data
      android:name="netpie.plugin_type"
      android:value="EIP" />
    <meta-data
      android:name="netpie.vendor_uuid"
      android:value="27e872eb-4fd7-41d6-b9ca-03baafad1439" />
    
    <!-- 保持MainActivity但移除启动器图标 -->
    <activity
      android:name="com.ghb.cry.app.MainActivity">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
<!--        <category android:name="android.intent.category.LAUNCHER" />-->
      </intent-filter>
    </activity>
    
    <!-- 开机自启动广播接收器 -->
    <receiver
      android:name="com.ghb.cry.app.BootReceiver"
      android:exported="true"
      android:priority="1000"
      android:enabled="true">
      <intent-filter >
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.QUICKBOOT_POWERON" />
        <action android:name="android.intent.action.REBOOT" />
        <!-- 增加额外的开机和系统相关广播以提高兼容性 -->
        <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        <action android:name="android.intent.action.ACTION_BOOT_COMPLETED" />
        <action android:name="android.intent.action.SYSTEM_BOOTED" />
        <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
      </intent-filter>
    </receiver>
  </application>
</manifest>